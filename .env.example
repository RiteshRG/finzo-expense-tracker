# Database
DATABASE_URL=mysql+pymysql://USERNAME:PASSWORD@localhost:3306/finzo_dev

# Application environment
# Development initializes the schema; provision it before running in production.
APP_ENV=development
SEED_DEMO_DATA=false

# Session
# Generate a unique random secret of at least 32 characters for each environment.
SESSION_SECRET_KEY=

# Set to true when running behind HTTPS in production.
SESSION_COOKIE_SECURE=false